# demo: chạy ngay, dữ liệu giả trong RAM; live: bắt buộc MongoDB + ThingsBoard.
APP_MODE=demo
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aotom
# Không đưa file .env lên git hoặc gửi trong chat. Dùng tài khoản ThingsBoard
# có quyền đọc telemetry và RPC của device; KHÔNG phải device access token.
TB_URL=https://thingsboard.cloud
TB_DEVICE_ID=
TB_USERNAME=
TB_PASSWORD=
# Hoặc JWT tạm thời. Để trống nếu dùng username/password tự đăng nhập lại.
TB_JWT=
TB_POLL_MS=5000
TB_RPC_PATH=/api/rpc/twoway
# Khởi tạo lùi 24h; sau đó đồng bộ liên tục theo từng key có chống trùng.
TB_BACKFILL_HOURS=24
# Chỉ cấu hình IP/URL camera của nhóm trên máy chạy backend.
CAMERA_STREAM_URL=
CAMERA_CAPTURE_URL=
