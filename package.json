{
  "name": "aotom-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local ESP32 shrimp pond workspace with ThingsBoard and MongoDB",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-browser-check.cjs",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js"
  },
  "dependencies": {
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
